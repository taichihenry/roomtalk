<?xml version="1.0" encoding="utf-8"?>
<!--
  入口页：一个输入框、一个按钮，没有别的。

  刻意做成「首屏即是它」——和网页端一致的极简取向：不解释、不引导、
  不塞任何多余的东西。用户输入口令 → 进入。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/lede"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!--
          口令输入。**默认遮蔽**，右侧留一个「显示 / 隐藏」切换 —— 和网页端一致
          （那边是 type="password" 配一颗「显示」按钮）。

          为什么要遮蔽：两人约定的暗号多半是当着旁边人的面敲进去的。
          但又不能只遮蔽不给看：输入法打错一个字符，症状会从「进不去」变成
          「对方一直没进来」—— 光盯着屏幕没法自证，必须留一个能核对的手段。
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp">

            <EditText
                android:id="@+id/passInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input"
                android:hint="@string/pass_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="60dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <!-- 必须写在 EditText 之后才盖在上层；paddingEnd 给足，别让口令文字钻到它下面 -->
            <TextView
                android:id="@+id/passToggle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:text="@string/pass_show"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/enterBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/enter"
            android:textColor="@color/on_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/gate_hint"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
