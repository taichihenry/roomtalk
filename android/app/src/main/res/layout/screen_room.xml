<?xml version="1.0" encoding="utf-8"?>
<!--
  房间页：顶栏（对方是谁 / 离开） + 消息流 + 输入栏（发起语音 / 视频通话 + 发消息）。

  通话一旦开始，整页会被 screen_call 盖住（不是替换），所以这里不需要「通话态」的外观。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/peerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/waiting"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ⚠ 顶栏刻意**不放**「请出房间」：那个动作属于信任条（见下面 trustBar），
             和网页端一致。同一个动作留两个入口，用户会猜哪个才是真的。 -->
        <ImageView
            android:id="@+id/leaveBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/leave"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/muted" />
    </LinearLayout>

    <!-- 状态条（连接中 / 已连接 / 对方未开麦…） -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/waiting"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <!--
      信任条（TOFU）。这块解决的是纯口令方案唯一的硬伤：
      口令只证明「知道这串字」，不证明「你是这个人」。

      ⚠ 房主专属的三个动作都在这里，不在顶栏 —— 与网页端一致。
      ⚠ 「自动请出」对房主一直可见（哪怕还没人进来），好让他提前把态度定下来。
    -->
    <LinearLayout
        android:id="@+id/trustBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/trustText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trustKeep"
                style="@style/MiniButton"
                android:text="@string/trust_keep"
                android:visibility="gone" />

            <TextView
                android:id="@+id/trustKick"
                style="@style/MiniButton"
                android:text="@string/kick"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <TextView
                android:id="@+id/trustUnblock"
                style="@style/MiniButton"
                android:text="@string/trust_unblock"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/autokickWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/autokick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/autokick"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 消息流 -->
    <ScrollView
        android:id="@+id/msgScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/msgList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <!--
      录音提示条。只在「按住说话」按下的那几秒里露出来。

      ⚠ 刻意**不做成浮层**（网页端是浮层）：手机上手指正压在按钮上，
        浮层如果盖在按钮附近会被手掌挡掉一半。放在输入栏正上方这一行，
        位置固定、不会被指头压住，而且它出现时只是把消息流顶高 26dp，
        不遮挡任何正在看的内容。
    -->
    <TextView
        android:id="@+id/recHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      输入栏。从左到右一排，和网页端的顺序**逐字对齐**：

          语音/键盘 · 附件 ·（输入框 | 按住说话）· 语音通话 · 视频通话 · 发送

      为什么不把「发文件」「按住说话」塞进二级菜单：这两个动作的发生频率和打字
      是一个量级的（微信就是这么放的），藏进「+」里等于每次多一次点击。
      代价是一排有 6 颗 40dp 的键，窄屏上输入框只剩 ~140dp —— 但这和网页端
      是同一个取舍，两端长得一样，用户不必重新学。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <!-- 语音 / 键盘 模式切换。图标随模式换（语音态显示键盘、文字态显示麦克风）。 -->
        <ImageView
            android:id="@+id/btnVoice"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/to_voice"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/muted" />

        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/attach"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_attach"
            android:tint="@color/muted" />

        <EditText
            android:id="@+id/msgInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/msg_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <!-- 「按住 说话」。语音模式下顶掉输入框的位置（同一个 layout_weight=1），
             这样切换时整排按钮一个都不挪 —— 拇指的位置记忆还是对的。 -->
        <TextView
            android:id="@+id/holdTalk"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hold_talk"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/hold_to_talk"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnAudioCall"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/call_audio"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_call"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/btnVideoCall"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/call_video"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_videocam"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/send"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_send"
            android:tint="@color/primary" />
    </LinearLayout>
</LinearLayout>
