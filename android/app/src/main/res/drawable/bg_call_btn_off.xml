<?xml version="1.0" encoding="utf-8"?>
<!--
  通话按钮的「关」态：实心红底 + 白图标。

  ⚠ 和 bg_call_btn_on（实心绿底）成对出现，缺一个就会退回「只有描边、看不出开关」的旧样子。
  图标本身仍留斜杠（ic_mic_off / ic_volume_off / ic_videocam_off）：颜色之外再给一道记号，
  色觉障碍的人也能分辨。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/call_off" />
</shape>
