<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 信令走 wss，媒体走 WebRTC 的 P2P（UDP）—— 两者都要联网权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 语音 / 视频通话 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      ⚠ MODIFY_AUDIO_SETTINGS 必须声明，否则通话音频路由会**静默失效**。
         WebRTC 的音频设备模块（WebRtcAudioManager / WebRtcAudioTrack）会调
         AudioManager.setMode(MODE_IN_COMMUNICATION) 和 setSpeakerphoneOn()。
         AOSP 的 AudioService.checkAudioSettingsPermission() 在缺权限时**只记一条
         warning 就返回 false**（不抛异常），所以症状不是崩溃，而是：
           · 免提开关点了没反应、声音还在听筒里
           · 音量键调的是「媒体音量」而不是「通话音量」
         这种「不报错但功能是坏的」最难查 —— 因为 app 侧看不到任何异常。
      -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 通话时要保持屏幕与 CPU 醒着，否则息屏会把通话掐掉 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 摄像头标成非必需：没有摄像头的设备（少数平板）仍然能装，只是不能视频 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.RoomTalk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RoomTalk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          收到的文件要能「用其他应用打开」，必须借 FileProvider 转成 content:// URI。

          ⚠ android:exported 必须是 false：这个 provider 只服务于「我主动递给
            某个应用的那一个文件」，不是给外部随便查的接口。
          ⚠ authorities 用 ${applicationId} 拼，不写死包名 —— 写死之后一旦改包名
            （debug 变体、渠道包）会静默失效，报错还是运行时才出。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
